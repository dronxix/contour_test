# Настройки запуска. Скопируйте в .env и поправьте под себя:
#     copy .env.example .env
# run.py читает .env из папки проекта сам; другой файл: python run.py in out --env my.env
# Переменная, заданная в окружении (set VERDICT_ZOOM=off), важнее значения в файле.
# Пустое значение (KEY=) означает значение по умолчанию.

# --- что считать при запуске ----------------------------------------------
# new — только новые листы и те, у которых изменился файл, код или настройки,
#       либо результат неполный или упал в прошлый раз; остальные пропускаются
# all — всё с нуля (то же, что python run.py ... --force); старые папки перезаписываются
RUN_SCOPE=new

# --- чтение чертежа (влияет на координаты контура) ------------------------
# PDF: в каком разрешении рендерить страницу.
# JPG/PNG/TIFF: картинка берётся как есть, без пересчёта; масштаб в мм — по штампу (185 мм).
#   CONTOUR_DPI используется для них, только если в файле нет DPI и штамп не найден.
# Больше dpi — тоньше видны линии, но медленнее; ниже ~200 тонкие и основные линии сливаются.
# При смене значения уже обработанные листы пересчитываются автоматически.
CONTOUR_DPI=300

# Выравнивание кривого скана: off | rotate | perspective
# off         — лист берётся как есть (по умолчанию; чертежи из CAD ровные).
# rotate      — меряется угол наклона (по рамке, штампу, строкам текста);
#               если он от 0,1° до 10°, лист поворачивается ровно.
# perspective — находятся 4 угла рамки и натягиваются на прямоугольник:
#               исправляет и поворот, и фото под углом. Рамка должна быть целиком на картинке.
# Изгиб и мятую бумагу не исправляет ни один режим. Координаты контура — в выправленном листе.
CONTOUR_DESKEW=off

# Остальные настройки ниже влияют только на вердикт, не на координаты.

# --- кто ставит вердикт ---------------------------------------------------
# auto   — файл ревью, если задан VERDICT_REVIEW_FILE; иначе модель, если задан VERDICT_MODEL; иначе off
# model  — живая модель по API
# review — готовые вердикты из файла ревью (привязаны к SHA-1 контура)
# off    — модель не спрашивать: все разобранные листы yellow «контур не проверен»
VERDICT_MODE=auto

# --- модель (нужна поддержка картинок) ------------------------------------
# Тип API — в каком формате говорить с сервером:
#   openai    — OpenAI и всё совместимое: LM Studio, Ollama, vLLM, OpenRouter
#   anthropic — Claude (Anthropic Messages API)
#   gemini    — Google Gemini
VERDICT_API_TYPE=openai
# Адрес; пусто — по умолчанию для типа:
#   openai    -> http://localhost:1234/v1 (LM Studio)
#               OpenAI: https://api.openai.com/v1   Ollama: http://localhost:11434/v1
#   anthropic -> https://api.anthropic.com
#   gemini    -> https://generativelanguage.googleapis.com
VERDICT_API_BASE=
VERDICT_MODEL=
# ключ: обязателен для anthropic и gemini, для локальных серверов не нужен
VERDICT_API_KEY=
#
# Примеры — заменить строки выше нужным блоком:
#   OpenAI:     VERDICT_API_TYPE=openai
#               VERDICT_API_BASE=https://api.openai.com/v1
#               VERDICT_MODEL=<модель OpenAI с картинками>
#               VERDICT_API_KEY=<ключ>
#   Claude:     VERDICT_API_TYPE=anthropic
#               VERDICT_MODEL=<модель Claude>
#               VERDICT_API_KEY=<ключ>
#   Gemini:     VERDICT_API_TYPE=gemini
#               VERDICT_MODEL=<модель Gemini>
#               VERDICT_API_KEY=<ключ>
#   LM Studio:  VERDICT_API_TYPE=openai
#               VERDICT_MODEL=<модель, загруженная в LM Studio>   (адрес и ключ не нужны)
#
# думающим моделям: none — сразу отвечать (OpenAI-тип: reasoning_effort, Gemini: без «размышлений»);
# если сервер такой параметр не принимает, программа сама его уберёт и запишет это в log.txt
VERDICT_REASONING=none
VERDICT_TIMEOUT=300
# лимит длины ответа (с запасом на скрытые рассуждения «думающих» моделей)
VERDICT_MAX_TOKENS=1000

# --- промпт ---------------------------------------------------------------
# системный промпт лежит отдельным файлом; путь относительно папки проекта
VERDICT_PROMPT_FILE=prompts/verdict_system.txt

# --- что модель видит ------------------------------------------------------
# длинная сторона картинки всего листа
VERDICT_IMAGE_PX=1024
# приближение: off — только весь лист; on — плюс крупные планы каждого вида;
# auto — крупные планы, если на картинке всего листа 1 мм листа меньше VERDICT_ZOOM_MIN_PX_PER_MM пикселей
VERDICT_ZOOM=auto
VERDICT_ZOOM_MIN_PX_PER_MM=5
VERDICT_ZOOM_PX=1024
VERDICT_ZOOM_MAX=6

# --- офлайн-ревью ----------------------------------------------------------
# JSON с готовыми вердиктами (режим review), привязанными к SHA-1 контура
VERDICT_REVIEW_FILE=
